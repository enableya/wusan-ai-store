# 复制为项目根 .env.sandbox.local；不存放沙箱密钥，密钥由 .alipay-sandbox.json 读取。
ALIPAY_ENV=sandbox
ALIPAY_ENABLED=true
LOVECODEX_ENABLED=true
API_HOST=127.0.0.1
API_PORT=5192
DATABASE_PATH=server/data/sandbox.sqlite
PUBLIC_SITE_URL=http://127.0.0.1:5190
ADMIN_ORIGIN=http://127.0.0.1:5190
ALIPAY_NOTIFY_URL=

# 邀请返利提现：独立于收款开关，默认禁用实际转账。审核功能不依赖该开关。
ALIPAY_TRANSFER_ENABLED=false
# 仅在已开通单笔转账产品、配置相同环境应用及商户申报的场景后启用。
ALIPAY_TRANSFER_SCENE_NAME=
# 按支付宝商户实际申报字段填写 JSON 数组：[{"info_type":"...","info_content":"..."}]
ALIPAY_TRANSFER_SCENE_REPORT_INFOS=[]
# 如转账应用使用证书模式，请同时配置以下三个受保护文件路径。
ALIPAY_TRANSFER_APP_CERT_PATH=
ALIPAY_TRANSFER_ROOT_CERT_PATH=
ALIPAY_TRANSFER_PUBLIC_CERT_PATH=
