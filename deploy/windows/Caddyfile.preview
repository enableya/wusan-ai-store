{
    admin 127.0.0.1:2019
    auto_https off
}
http://127.0.0.1:8080 {
    bind 127.0.0.1
    @private path /.env* /.git/* /server/* /deploy/* /package*.json /release.json
    handle @private {
        respond 403
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:5182
    }
    handle {
        root * C:/WusanAI/current/dist
        try_files {path} /index.html
        file_server
    }
}
