# Server-only configuration, stored outside the web root. Use forward slashes.
NODE_ENV=production
WUSAN_PROFILE=production
API_HOST=127.0.0.1
API_PORT=5182
DATABASE_PATH=C:/ProgramData/WusanAI/data/store.sqlite
PUBLIC_SITE_URL=https://wusan-ai.store
ADMIN_ORIGIN=https://wusan-ai.store
ALIPAY_NOTIFY_URL=https://wusan-ai.store/api/payments/alipay/notify
ALIPAY_ENV=production
ALIPAY_ENABLED=false
LOVECODEX_ENABLED=true
# Keep public purchasing closed during administrator-only live acceptance.
PUBLIC_CHECKOUT_ENABLED=false
ALIPAY_APP_ID=2021007108662753
ALIPAY_SELLER_ID=2088132908533024
ALIPAY_PRIVATE_KEY_PATH=C:/ProgramData/WusanAI/keys/app-private.keytext
ALIPAY_PUBLIC_KEY_PATH=C:/ProgramData/WusanAI/keys/alipay-public.keytext

# 邀请返利提现：独立于收款开关，默认禁用实际转账。审核功能不依赖该开关。
ALIPAY_TRANSFER_ENABLED=false
# 仅在已开通单笔转账产品、配置相同环境应用及商户申报的场景后启用。
ALIPAY_TRANSFER_SCENE_NAME=
# 按支付宝商户实际申报字段填写 JSON 数组：[{"info_type":"...","info_content":"..."}]
ALIPAY_TRANSFER_SCENE_REPORT_INFOS=[]
# 如转账应用使用证书模式，请同时配置以下三个受保护文件路径。
ALIPAY_TRANSFER_APP_CERT_PATH=
ALIPAY_TRANSFER_ROOT_CERT_PATH=
ALIPAY_TRANSFER_PUBLIC_CERT_PATH=
