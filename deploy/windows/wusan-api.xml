<service>
  <id>WusanApi</id>
  <name>Wusan AI API</name>
  <description>Wusan AI store production API, using the migrated database.</description>
  <executable>C:\WusanAI\bin\node.exe</executable>
  <arguments>--max-old-space-size=384 C:\WusanAI\current\server\index.ts</arguments>
  <workingdirectory>C:\WusanAI\current</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="WUSAN_PROFILE" value="production" />
  <env name="WUSAN_ENV_FILE" value="C:\ProgramData\WusanAI\production.env" />
  <serviceaccount><domain>NT AUTHORITY</domain><user>LocalService</user></serviceaccount>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>15 sec</stoptimeout>
  <logpath>C:\ProgramData\WusanAI\logs\api</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>5</keepFiles></log>
</service>
