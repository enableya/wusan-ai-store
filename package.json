{
  "name": "wusan-ai-store",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs scripts/dev.mjs",
    "dev:sandbox": "node scripts/run.mjs scripts/profile.mjs sandbox dev --port 5190",
    "dev:client": "node scripts/run.mjs node_modules/vite/bin/vite.js --host 127.0.0.1",
    "start:api": "node scripts/run.mjs server/index.ts",
    "start:production": "node scripts/run.mjs scripts/profile.mjs production api",
    "payment:check:sandbox": "node scripts/run.mjs scripts/profile.mjs sandbox check",
    "payment:check:production": "node scripts/run.mjs scripts/profile.mjs production check",
    "test:environment": "node scripts/run.mjs --test server/environment.test.ts",
    "catalog": "node scripts/run.mjs server/catalog-cli.ts",
    "admin": "node scripts/run.mjs server/admin-cli.ts",
    "test:api": "node scripts/run.mjs --test server/api.test.ts server/payments.test.ts server/admin.test.ts",
    "test:runtime": "node scripts/run.mjs --test scripts/runtime.test.mjs",
    "test:dev": "node scripts/run.mjs --test scripts/dev.test.mjs",
    "build": "node scripts/run.mjs node_modules/typescript/bin/tsc -b && node scripts/run.mjs node_modules/vite/bin/vite.js build",
    "package:deploy": "npm run build && node scripts/run.mjs scripts/package-deploy.mjs",
    "preview": "node scripts/run.mjs node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "typecheck": "node scripts/run.mjs node_modules/typescript/bin/tsc -b",
    "test": "node scripts/run.mjs node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/run.mjs node_modules/@playwright/test/cli.js test",
    "test:admin:e2e": "node scripts/run.mjs scripts/test-admin.mjs",
    "payment": "node scripts/run.mjs server/payment-cli.ts"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
