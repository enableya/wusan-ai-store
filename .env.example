VITE_SITE_NAME=伍叁 AI
VITE_SUPPORT_EMAIL=
VITE_MERCHANT_NAME=
VITE_SUPPORT_HOURS=
VITE_SUPPORT_RESPONSE_TIME=
API_HOST=127.0.0.1
API_PORT=5182
DATABASE_PATH=server/data/store.sqlite

# AI 网页应用收款。沙箱从项目根 .alipay-sandbox.json 直接读取，不复制密钥到环境变量。
ALIPAY_ENABLED=false
ALIPAY_ENV=sandbox
PUBLIC_SITE_URL=http://127.0.0.1:5180
# 后台及商品统计的访问源；内部预览可用实际回环地址，正式上线使用 HTTPS 域名。
ADMIN_ORIGIN=http://127.0.0.1:5180
# 无公网 HTTPS 回调时留空，服务端查询用于确认结果；生产必须配置。
ALIPAY_NOTIFY_URL=
# 下列配置仅用于 production，同一应用的原始 PKCS#1 私钥、公钥字符串，不含 PEM 头尾。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# 也可设置 ALIPAY_PRIVATE_KEY / ALIPAY_PUBLIC_KEY；不得设置 VITE_ 前缀。
